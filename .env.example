BANK_USERNAME=
BANK_PASSWORD=
DAYS_BACK=30
PORT=3001

# Persisted scraper sessions (cookies / auth-state). Docker mounts this as a volume.
SESSION_DIR=/app/sessions
# Optional override per provider (defaults live under SESSION_DIR/<profile>/)
# AUTH_STATE_PATH=/app/sessions/bank/auth-state.json
# CAL_AUTH_STATE_PATH=/app/sessions/visa-cal/auth-token.txt
# HAREL_AUTH_STATE_PATH=/app/sessions/harel-meni/auth-state.json
# EFRAT_HAREL_AUTH_STATE_PATH=/app/sessions/harel-efrat/auth-state.json
# MEITAV_PENSION_AUTH_STATE_PATH=/app/sessions/meitav-pension/auth-state.json
# PHOENIX_AUTH_STATE_PATH=/app/sessions/phoenix/auth-state.json

# Excellence Extrade Pro Credentials
EXTRADE_LOGIN_URL=https://extradepro.xnes.co.il/login
EXTRADE_USERNAME=
EXTRADE_PASSWORD=

# Interactive Brokers Flex Web Service
IBKR_FLEX_TOKEN=
IBKR_QUERY_ID=

# Visa CAL Credit Card Credentials
CAL_USERNAME=
CAL_PASSWORD=

# Meitav Trade Credentials
MEITAV_LOGIN_URL=https://sparkmeitav.ordernet.co.il/
MEITAV_USERNAME=
MEITAV_PASSWORD=
# Optional: restrict to one account number (e.g. 487367)
MEITAV_ACCOUNT_ID=

# Harel Pension & Insurance — Meni (Passwordless SMS Login)
HAREL_LOGIN_URL=https://www.harel-group.co.il/Pages/login-Page/Login.aspx
HAREL_ID_NUMBER=
HAREL_PHONE_NUMBER=

# Efrat - Meitav Gemel & Pension (Passwordless SMS Login)
MEITAV_PENSION_LOGIN_URL=https://customers.meitav.co.il/v2/login/loginAmit
MEITAV_PENSION_ID_NUMBER=
MEITAV_PENSION_PHONE_NUMBER=

# Efrat - The Phoenix (הפניקס)
PHOENIX_LOGIN_URL=https://fnx.co.il
PHOENIX_ID_NUMBER=
PHOENIX_PHONE_NUMBER=

# Efrat - Harel Provident Fund (קופת גמל)
EFRAT_HAREL_ID_NUMBER=
EFRAT_HAREL_PHONE_NUMBER=
